---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ResearchPillar from '../components/ResearchPillar.astro';
import ResearchDirections from '../components/ResearchDirections.astro';
import WorkEntry from '../components/WorkEntry.astro';
import ServiceEntry from '../components/ServiceEntry.astro';
import PublicationList from '../components/PublicationList.astro';

import { site, contact, activeLinks } from '../data/site.ts';
import { researchAreas, researchDirections } from '../data/research.ts';
import { work } from '../data/work.ts';
import { service } from '../data/service.ts';
import { publications } from '../data/publications.ts';
import { biography } from '../data/about.ts';
---

<BaseLayout path="/" structuredData>
  <section class="hero" aria-labelledby="hero-name">
    <div class="page hero__inner">
      <h1 class="hero__name" id="hero-name">{site.name}</h1>
      <p class="hero__field">{site.field}</p>
      <p class="hero__statement">{site.statement}</p>
      <ul class="hero__areas" aria-label="Research areas">
        {site.researchAreas.map((area) => <li>{area}</li>)}
      </ul>
    </div>
  </section>

  <Section id="research" label="Research">
    <div class="pillars">
      {
        researchAreas.map((area, i) => (
          <ResearchPillar area={area} index={i + 1} />
        ))
      }
    </div>
  </Section>

  <Section id="research-directions" label="Research Directions">
    <ResearchDirections directions={researchDirections} />
  </Section>

  <Section id="work" label="Selected Work">
    {/* Degrees are stated in the About biography and carried in alumniOf —
        repeating them here read as résumé filler. The `education` data stays
        in work.ts for the structured data. */}
    <div class="entries">
      {work.map((entry) => <WorkEntry entry={entry} />)}
    </div>
  </Section>

  <Section id="service" label="Professional Service">
    <div class="entries">
      {service.map((entry) => <ServiceEntry entry={entry} />)}
    </div>
  </Section>

  {/* Omitted entirely while there is nothing to list — see publications.ts. */}
  {
    publications.length > 0 && (
      <Section id="publications" label="Publications & Preprints">
        <PublicationList publications={publications} />
      </Section>
    )
  }

  <Section id="about" label="About">
    <div class="prose">
      {biography.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div class="contact">
      <h3 class="label">Contact</h3>
      {
        contact.email ? (
          <p class="contact__note">
            For research and professional inquiries:{' '}
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </p>
        ) : (
          <p class="contact__note">{contact.note}</p>
        )
      }

      {
        activeLinks.length > 0 && (
          <p class="contact__links">
            {activeLinks.map((link) => (
              <a href={link.href} rel="me noopener" target="_blank">
                {link.label}
              </a>
            ))}
          </p>
        )
      }
    </div>
  </Section>
</BaseLayout>
